# Required for workflow model calls.
GROQ_API_KEY=

# Required only when starting the GitHub profile.
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# Optional GitHub intake tuning.
# GITHUB_POLL_INTERVAL_S=60
# GITHUB_MAX_STARTS_PER_CYCLE=1
# GITHUB_MAX_STARTS_PER_DAY=10
# GITHUB_BODY_MAX_CHARS=8000

# Set to true when GITHUB_TOKEN belongs to your own account, so issues you open
# are processed. Leave false for a dedicated bot account. Use a fine-grained
# token limited to the one fork (Issues read/write, Metadata read).
# GITHUB_PROCESS_OWN_ISSUES=false
